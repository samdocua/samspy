# SamSpy — environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Version history:
#   v0.1.0 (2026-11-17) — Supabase + Virlo + cron secret.
#   v0.4.0 (2026-11-18) — Gemini + OpenAI keys for the «Слайды» tab.
#   v0.4.1 (2026-11-18) — OpenAI key replaced by FAL_KEY (GPT Image via fal.ai).
#   v0.5.0 (2026-11-18) — Apify + Anthropic for the «Карусели» tab.
#   v0.6.0 (2026-11-19) — optional OpenAI key for the second slide check (GPT).

# --- Supabase (Settings -> API) ---------------------------------------------
# Project URL and anon key are public (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key is SECRET — server-side only. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Virlo (dev.virlo.ai -> dashboard -> API keys) --------------------------
# SECRET. Billed per request. Format: virlo_tkn_...
VIRLO_API_KEY=virlo_tkn_your_key_here

# --- Slides: image generation -------------------------------------------------
# SECRET, server-side only. Each key is needed only for its own models.
# Gemini: aistudio.google.com -> Get API key
GEMINI_API_KEY=your-gemini-api-key
# fal.ai: fal.ai/dashboard/keys — GPT Image edit models, no OpenAI verification
FAL_KEY=your-fal-key
# OPTIONAL — second opinion when checking slides (GPT looks at slides that passed
# the main Claude check). Without it the second check is simply skipped.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_CHECK_MODEL=gpt-5.4-mini

# --- «Карусели» tab (carousel slide texts) -----------------------------------
# Apify (console.apify.com -> Settings -> API & Integrations). SECRET.
APIFY_TOKEN=apify_api_your_token
# Optional: dami (default, $0.18/1k posts) | official ($1.50/1k posts)
# APIFY_ACTOR=dami
# Optional: how many recent posts per author for the outlier median (5–50, default 20)
# APIFY_PROFILE_POSTS=20

# --- «Анализ» tab (account dossiers) — uses APIFY_TOKEN above ----------------------
# Optional: max posts per dossier (period = last year; 50–3000, default 1500)
# ANALYSIS_MAX_POSTS=1500

# Anthropic (console.anthropic.com -> API keys). SECRET.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional model overrides:
# CAROUSEL_OCR_MODEL=claude-haiku-5-5        # OCR + text check
# CAROUSEL_ESCALATE_MODEL=claude-sonnet-5-5  # re-read of flagged slides

# --- App ---------------------------------------------------------------------
# A long random string. Signs the cron-sync auth and the login cookie.
# Generate one: `openssl rand -hex 32`
SAMSPY_SECRET=change-me-to-a-long-random-string

# The shared login password for the whole app. Pick anything you like.
SAMSPY_PASSWORD=choose-a-password

# Default outlier threshold for the catalog (reels with ratio >= this show up).
NEXT_PUBLIC_DEFAULT_OUTLIER_THRESHOLD=3
